{
  "name": "verifire-cosmos-pay-test",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && npm test && astro build",
    "preview": "astro preview",
    "start": "node --env-file-if-exists=.env ./dist/server/entry.mjs",
    "check": "astro check",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contract:deploy": "node --env-file-if-exists=.env scripts/deploy-contract.ts",
    "contract:upgrade": "node --env-file-if-exists=.env scripts/upgrade-contract.ts",
    "contract:test-activation": "node --env-file-if-exists=.env scripts/test-activation.ts",
    "test:solana": "cargo test --manifest-path solana/Cargo.toml",
    "solana:init": "node --env-file-if-exists=.env scripts/solana-init.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@cavos/kit": "^0.1.12",
    "@cosmosapp/pay_sdk": "^1.2.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@nanostores/react": "^2.0.1",
    "@privy-io/react-auth": "^3.47.0",
    "@solana-program/memo": "^0.15.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.0.1",
    "astro": "^7.3.2",
    "buffer": "^6.0.3",
    "jsqr": "^1.4.0",
    "nanostores": "^1.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
