---
import '@fortawesome/fontawesome-free/css/all.min.css';
import '@/styles/brand.css';
import '@/styles/global.css';
import { Font } from 'astro:assets';
import SessionGate from '@/components/layout/SessionGate.astro';
import { PrivyBridge } from '@/components/wallet/PrivyBridge';
import { MOTION_KEY, THEME_KEY } from '@/lib/client/theme';
import { publicConfig } from '@/lib/server/config';
import { pageLocale } from '@/lib/server/page-locale';

interface Props {
  title: string;
  description: string;
  bodyClass: string;
  session?: 'public' | 'protected' | 'guest' | 'landing';
  // Pages written in a single language say so, whatever language the landing was left in.
  lang?: string;
}

const { title, description, bodyClass, session = 'public', lang } = Astro.props;
---

<!doctype html>
<html lang={lang ?? pageLocale(Astro)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline define:vars={{ THEME_KEY, MOTION_KEY }}>
      try {
        const theme = localStorage.getItem(THEME_KEY);
        if (theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches))
          document.documentElement.dataset.theme = 'dark';
        if (localStorage.getItem(MOTION_KEY) === 'off') document.documentElement.dataset.motion = 'off';
      } catch {
        // Without storage the page stays light and animated.
      }
    </script>
    {session !== 'public' && <SessionGate mode={session} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-urbanist" preload={[{ weight: 500 }, { weight: 800 }]} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <slot />
    <!-- The wallet is Privy's: every page mounts its bridge, so any island can log in and sign. -->
    <PrivyBridge client:only="react" appId={publicConfig.privyAppId} cluster={publicConfig.solanaCluster} />
  </body>
</html>
