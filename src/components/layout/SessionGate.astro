---
// Decides, before the page is painted, whether it has to leave: it must run inline in <head>, so it cannot wait for
// the bundled scripts. Pages behind login also call guardSession() (src/lib/client/session.ts), which does the redirect.
import { IN_APP_KEY, SESSION_KEY, SESSION_MAX_MS } from '@/lib/client/session';

interface Props {
  // protected: needs an active session. guest: the login page, which an active session skips. landing: the home page,
  // which a tab already inside the panel skips, and which shows the profile instead of the login links to a session.
  mode: 'protected' | 'guest' | 'landing';
}

const { mode } = Astro.props;
---

<script is:inline define:vars={{ IN_APP_KEY, SESSION_KEY, SESSION_MAX_MS, mode }}>
  const isActive = () => {
    try {
      const session = JSON.parse(localStorage.getItem(SESSION_KEY) || 'null');
      return Boolean(session) && Date.now() - session.startedAt < SESSION_MAX_MS;
    } catch {
      return false;
    }
  };
  const inApp = () => {
    try {
      return sessionStorage.getItem(IN_APP_KEY) === '1';
    } catch {
      return false;
    }
  };
  const active = isActive();
  if (mode === 'landing') {
    if (active && inApp()) {
      document.documentElement.classList.add('is-redirecting');
      window.location.replace('/app');
    } else if (active) {
      document.documentElement.classList.add('has-session');
    }
    // Going back from the panel can restore this page from the cache without running this script again.
    window.addEventListener('pageshow', (event) => {
      if (event.persisted && isActive() && inApp()) window.location.replace('/app');
    });
  } else if (mode === 'protected' && !active) {
    // The guard sends the user to the login page: keep the page hidden so it never flashes.
    document.documentElement.classList.add('is-redirecting');
  } else if (mode === 'guest' && active) {
    // Already logged in: leave for the panel before the login form is drawn.
    document.documentElement.classList.add('is-redirecting');
    window.location.replace('/app');
  }
</script>
