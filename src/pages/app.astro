---
import { InvitationInbox } from '@/components/invitations/InvitationInbox';
import AppTopbar from '@/components/layout/AppTopbar.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import { WorkspaceSync } from '@/components/company/WorkspaceSync';
import LanguageMenu from '@/components/ui/LanguageMenu.astro';
import { ProfileMenu } from '@/components/warranties/ProfileMenu';
import { WarrantyDashboard } from '@/components/warranties/WarrantyDashboard';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getConsumerMessages } from '@/i18n/consumer';
import { getLandingMessages } from '@/i18n/landing';
import { DEFAULT_LOCALE, LOCALE_COOKIE, toLocale } from '@/lib/locale';
import '@/styles/consumer.css';

// The language chosen on the landing (see the locale middleware); this page has a single route.
const locale = toLocale(Astro.cookies.get(LOCALE_COOKIE)?.value) ?? toLocale(Astro.currentLocale) ?? DEFAULT_LOCALE;
const copy = getConsumerMessages(locale);
const { profile, nav } = getLandingMessages(locale);
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  bodyClass="catalog-body consumer-page"
  session="protected"
>
  <AppTopbar>
    <a class="wallet-button app-home-button" href={locale === 'en' ? '/en' : '/'} aria-label={copy.topbar.homeLabel} data-leave-app>
      <i class="fa-solid fa-house" aria-hidden="true"></i> <span>{copy.topbar.home}</span>
    </a>
    <LanguageMenu locale={locale} label={nav.language} mode="query" />
    <InvitationInbox client:load locale={locale} />
    <ProfileMenu client:load labels={profile} />
  </AppTopbar>

  <main class="container dashboard">
    <WarrantyDashboard client:load locale={locale} />
    <WorkspaceSync client:load />
  </main>

  <SiteFooter />

  <script>
    import { captureClaimLink } from '@/lib/client/qr';
    import { guardSession, IN_APP_KEY } from '@/lib/client/session';
    import { removeStored } from '@/lib/client/storage';

    // A secret QR link opened without a session is kept for after the login.
    captureClaimLink();
    guardSession();
    // The home page sends back here whoever is inside the app in this tab: going there on purpose leaves the app.
    document.querySelector('[data-leave-app]')?.addEventListener('click', () => removeStored(sessionStorage, IN_APP_KEY));
  </script>
</BaseLayout>
