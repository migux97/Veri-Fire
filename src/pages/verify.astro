---
// Public page behind the QR on the outside of the box: anyone (for example store staff) can check a product here
// without logging in. It only shows public data and does not link to the rest of the app.
import LocalDates from '@/components/layout/LocalDates.astro';
import StandaloneHeader from '@/components/layout/StandaloneHeader.astro';
import { IssuerBadge } from '@/components/ui/IssuerBadge';
import { ProductDetails } from '@/components/verification/ProductDetails';
import { ProductHistory } from '@/components/verification/ProductHistory';
import { VerifyScanner } from '@/components/verification/VerifyScanner';
import { getVerifyMessages } from '@/i18n/verify';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { pageLocale } from '@/lib/server/page-locale';
import { findProduct, publicProductView, recordVerification } from '@/lib/server/products';
import { withinBudget } from '@/lib/server/rate-limit';
import { scanCountry } from '@/lib/scan-signals';

const locale = pageLocale(Astro);
const copy = getVerifyMessages(locale);

const requestedToken = Astro.url.searchParams.get('token') ?? '';
const found = requestedToken.trim() ? findProduct(requestedToken) : undefined;
// Every check with the public QR goes into the product's history (see recordVerification). Recording writes the
// store, so an address that walks through the (sequential) tokens only gets a few recorded; the page still answers.
// The country comes from Cloudflare, in front of the public server; without it the check is recorded without one.
if (found && withinBudget('verify-record', Astro.clientAddress, 30)) recordVerification(found, scanCountry(Astro.request.headers.get('cf-ipcountry')));
const product = found ? publicProductView(found) : null;

// Only a verified issuer lets the page say "original": for anyone else the record proves the code is unique, not the product.
const trust = product ? (product.issuer?.verified ? 'verified' : product.issuer ? 'unverified' : 'unknown') : null;

let title = copy.product.title;
let message = copy.product.lead;
if (product) {
  const original = trust === 'verified';
  title = product.claimed
    ? (original ? copy.product.claimedTitle : copy.product.registeredClaimedTitle)
    : (original ? copy.product.sealedTitle : copy.product.registeredSealedTitle);
  if (product.lastTransfer) message = copy.product.transferred.replace('{to}', product.lastTransfer.to);
  else if (product.claimed) message = copy.product.claimed;
  else message = copy.product.sealed;
}

// A sign that the labels were copied, in words: countries by name in the page's language.
let copyWarning: string | null = null;
if (product?.copySignal) {
  const regions = new Intl.DisplayNames([locale], { type: 'region' });
  copyWarning = product.copySignal.kind === 'rejected-claim'
    ? copy.product.copy.rejected
    : copy.product.copy.distantScans
      .replace('{first}', regions.of(product.copySignal.countries[0]) ?? product.copySignal.countries[0])
      .replace('{second}', regions.of(product.copySignal.countries[1]) ?? product.copySignal.countries[1]);
}
if (!product && requestedToken.trim()) {
  title = copy.product.notFoundTitle;
  message = copy.product.notFound;
  Astro.response.status = 404;
}
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} bodyClass="verify-page">
  <main class="verify-shell">
    <StandaloneHeader>
      <span class="network-status"><span></span>{copy.header.network}</span>
    </StandaloneHeader>

    <section class="verify-card" aria-labelledby="verify-title">
      <div class="verify-intro">
        <div class="verify-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></div>
        <div>
          <span class="eyebrow">{copy.header.eyebrow}</span>
          <h1 id="verify-title">{title}</h1>
        </div>
      </div>
      <p class="verify-message">{message}</p>
      {trust && (
        <p class={`verify-trust is-${trust}`} role="note">
          <i class={`fa-solid ${trust === 'verified' ? 'fa-circle-check' : 'fa-triangle-exclamation'}`} aria-hidden="true"></i>
          {' '}
          {copy.product.trust[trust]}
          {trust === 'verified' && product?.issuer?.domain && ` ${copy.product.trust.verifiedSite.replace('{domain}', product.issuer.domain)}`}
        </p>
      )}
      {copyWarning && (
        <p class="verify-trust is-copy" role="alert">
          <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
          {' '}
          {copyWarning}
        </p>
      )}
      {product?.photoUrl && <img class="verify-photo" src={product.photoUrl} alt={copy.photoAlt.replace('{model}', product.model)} loading="lazy" decoding="async" />}
      {product?.issuer && <IssuerBadge issuer={product.issuer} labels={{ issuedBy: copy.issuer.issuedBy, write: copy.issuer.write, call: copy.issuer.call, verified: copy.issuer.verified, unverified: copy.issuer.unverified }} />}
      {product && <ProductDetails product={product} locale={locale} />}
      {
        product && product.history.length > 0 && (
          <section class="verify-history" aria-labelledby="history-title">
            <h2 id="history-title">{copy.product.history}</h2>
            <ProductHistory events={product.history} timeZone="UTC" locale={locale} />
          </section>
        )
      }

      <VerifyScanner client:load locale={locale} />

      <form class="verification-form" method="get" action="/verify">
        <label for="verification-code">{copy.form.label}</label>
        <div class="verification-input-row">
          <input id="verification-code" name="token" type="text" placeholder={copy.form.placeholder} autocomplete="off" spellcheck="false" value={requestedToken} required />
          <button class="button button-primary" type="submit"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> {copy.form.submit}</button>
        </div>
        <span class="verification-hint">{copy.form.note}</span>
      </form>
    </section>
  </main>

  {product && <LocalDates />}
</BaseLayout>
