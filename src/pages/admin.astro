---
import StandaloneHeader from '@/components/layout/StandaloneHeader.astro';
import { WorkspaceSync } from '@/components/company/WorkspaceSync';
import { PurchaseForm } from '@/components/purchase/PurchaseForm';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { countryOptions } from '@/lib/server/countries';
---

<BaseLayout
  title="Verifire | Comprar tokens"
  description="Compra de tokens y etiquetas QR para empresas en Verifire."
  bodyClass="verify-page"
  session="protected"
>
  <main class="verify-shell admin-shell">
    <StandaloneHeader brandHref="/app">
      <a class="network-status" href="/batches"><span></span>Ver mis lotes</a>
    </StandaloneHeader>

    <section class="verify-card" aria-labelledby="new-batch-title">
      <span class="eyebrow">Nuevo lote</span>
      <h1 id="new-batch-title">Comprá tokens con Solana Pay</h1>
      <p class="verify-message">Cada token tiene un precio fijo en USDC. El lote se genera cuando se confirma el pago en Solana, y queda guardado en Mis lotes con sus etiquetas.</p>
      <PurchaseForm client:load countries={countryOptions} />
      <WorkspaceSync client:load />
    </section>
  </main>

  <script>
    import { storedUser } from '@/lib/client/account';
    import { CREATE_COMPANY_PATH } from '@/lib/client/company-signup';
    import { guardSession, userSession } from '@/lib/client/session';
    import { currentWorkspace } from '@/lib/client/workspace';

    guardSession();
    // Buying batches is done for a company: an account without one registers it first.
    if (userSession.isActive() && !currentWorkspace(storedUser())) window.location.replace(CREATE_COMPANY_PATH);
  </script>
</BaseLayout>
