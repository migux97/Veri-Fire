# Solana cluster: devnet (default), testnet or mainnet-beta, and an optional RPC URL for it (defaults to the public
# devnet RPC).
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=

# The VeriFire program (`anchor keys list`, see solana/README.md). While it is empty, warranties are stored only locally
# (demo mode).
SOLANA_PROGRAM_ID=
# Keypair of the server (solana-keygen JSON or base58): registers products. It is not the program's admin nor its
# upgrade authority, which stay off the server. Server only, never commit.
SOLANA_MINTER_SECRET=
# Optional: a separate keypair that pays rent and the users' network fees. Defaults to the minter.
SOLANA_FEE_PAYER_SECRET=

# Solana Pay: the treasury wallet that receives the USDC of each batch. It never signs anything on the server, so a
# customer reading a certificate never reaches the company's finances. Its USDC token account must exist
# (`spl-token create-account <USDC mint> --owner <treasury>`).
SOLANA_PAY_RECIPIENT=
# Price per token, in USDC.
PRICE_PER_TOKEN=1
# Optional: the token to charge in, when it is not Circle's USDC of the cluster (on devnet:
# 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU, free at faucet.circle.com).
USDC_MINT=

# Privy App ID (dashboard.privy.io): buyers and companies log in with Privy (email code or Google), which creates and
# holds their Solana wallet. Enable email, Google and Solana embedded wallets, and add this site to the allowed origins.
PRIVY_APP_ID=

# Solana wallets of the people who verify companies, separated by commas. They open /verificacion, read the companies
# with what they declared and approve or reject them, always signing with their wallet. Leave empty and nobody can.
ADMIN_WALLETS=

# Optional: long random token that enables POST /api/products (Authorization: Bearer <token>).
# Leave empty to disable direct product minting.
ADMIN_API_TOKEN=

# Public address printed inside the QR labels and the emails (e.g. https://verifire.example). Required on the server
# (see the server guide, VeriFire-servidor/README.md); locally it defaults to the address each request arrives at.
PUBLIC_APP_URL=

# Optional: origin allowed to call the API from another domain (e.g. https://mi-frontend.com).
# Leave empty when the frontend is served by this same server.
CORS_ORIGIN=

# Optional: where products, batches and purchases are stored. Defaults to data/verifire-state.json (relative to where
# the server is started). On the server: /var/lib/verifire/verifire.json.
DATA_FILE=

# Resend (resend.com) sends the team invitations by email. Create an API key (starts with re_) and use a sender from a
# domain verified in Resend, e.g. "Verifire <invitaciones@tudominio.com>". Without a verified domain Resend only
# delivers to the email of the Resend account itself (sender onboarding@resend.dev).
# Leave the key empty to invite only through the panel, links and QR codes.
RESEND_API_KEY=
RESEND_FROM=
# The links inside the emails use PUBLIC_APP_URL: set it to the public address, or they will point to localhost.

# Port of the production server (npm start). `npm run dev` always uses 5501 (astro.config.ts). On the server the service
# also sets HOST=127.0.0.1, so only Caddy reaches it (VeriFire-servidor/verifire.service).
PORT=5501

# Only for `npm run solana:init`: keypair file of the upgrade authority (default ~/.config/solana/id.json).
SOLANA_ADMIN_KEYPAIR=
