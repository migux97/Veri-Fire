# Cosmos Pay testnet key (starts with dv_). Never commit the real value.
COSMOS_PAY_API_KEY=dv_REPLACE_WITH_YOUR_TESTNET_KEY

# Public Stellar testnet account that receives test payments (starts with G...)
COSMOS_PAY_DESTINATION=G_REPLACE_WITH_YOUR_TESTNET_ACCOUNT

# Wallets (G...) of the people who verify companies, separated by commas. They open /verificacion, read the companies
# with what they declared and approve or reject them, always signing with their wallet. Leave empty and nobody can.
ADMIN_WALLETS=

# Optional: long random token that enables POST /api/products (Authorization: Bearer <token>).
# Leave empty to disable direct product minting.
ADMIN_API_TOKEN=

# Cavos App ID (dashboard). Needed to verify the Gmail and to open the buyer's Stellar wallet.
CAVOS_APP_ID=

# Public address printed inside the QR labels and the emails (e.g. https://verifire.example). Required on the server
# (see the server guide, VeriFire-servidor/README.md); locally it defaults to the address each request arrives at.
PUBLIC_APP_URL=

# Optional: origin allowed to call the API from another domain (e.g. https://mi-frontend.com).
# Leave empty when the frontend is served by this same server.
CORS_ORIGIN=

# Optional: where products, batches and purchases are stored. Defaults to data/verifire-state.json (relative to where
# the server is started). On the server: /var/lib/verifire/verifire.json.
DATA_FILE=

# Two separate Stellar accounts, so a customer reading a certificate never reaches the company's finances:
#   Treasury (COSMOS_PAY_DESTINATION above): receives the Cosmos Pay payments for each batch. Never signs on-chain.
#   Issuer (STELLAR_ISSUER_SECRET below): registers products, certifies warranties and pays their network fees.
#     It holds only the small balance needed for those fees; top it up from the treasury off-band.
# `npm run contract:deploy` fills these three in .env.
# While STELLAR_CONTRACT_ID is empty, warranties are stored only locally (demo mode).
STELLAR_NETWORK=
STELLAR_CONTRACT_ID=
# Set by npm run contract:deploy -- --force: the replaced contract. Its products are registered again in the new one.
STELLAR_PREVIOUS_CONTRACT_ID=
# Secret key of the issuing account. Server only, never commit. (Old name: STELLAR_ADMIN_SECRET.)
STELLAR_ISSUER_SECRET=
# Optional: Soroban RPC endpoint (defaults to the public testnet RPC).
STELLAR_RPC_URL=

# Resend (resend.com) sends the team invitations by email. Create an API key (starts with re_) and use a sender from a
# domain verified in Resend, e.g. "Verifire <invitaciones@tudominio.com>". Without a verified domain Resend only
# delivers to the email of the Resend account itself (sender onboarding@resend.dev).
# Leave the key empty to invite only through the panel, links and QR codes.
RESEND_API_KEY=
RESEND_FROM=
# The links inside the emails use PUBLIC_APP_URL: set it to the public address, or they will point to localhost.

# Test amount per token.
COSMOS_PAY_AMOUNT=100
# Port of the production server (npm start). `npm run dev` always uses 5501 (astro.config.ts). On the server the service
# also sets HOST=127.0.0.1, so only Caddy reaches it (VeriFire-servidor/verifire.service).
PORT=5501

# Blockchain that certifies products: stellar (default) or solana. See docs/migracion-solana.md.
CHAIN=
# Solana only. Program id (anchor keys list) and the server's keypair (solana-keygen JSON or base58), which registers
# products; the fee payer defaults to it. Never commit real values.
SOLANA_PROGRAM_ID=
SOLANA_MINTER_SECRET=
SOLANA_FEE_PAYER_SECRET=
# devnet (default), testnet or mainnet-beta, and an optional RPC URL for it.
SOLANA_CLUSTER=
SOLANA_RPC_URL=
# Privy App ID (dashboard.privy.io): with CHAIN=solana, buyers and companies log in with Privy, which holds their wallet.
PRIVY_APP_ID=
